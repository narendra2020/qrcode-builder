# --- Shared with portfolio-builder (MUST match its values) ---
DATABASE_URL=postgresql+psycopg2://portfolio:changeme@localhost:5433/portfolio_builder_db
JWT_SECRET_KEY=insecure-dev-secret-change-me
JWT_ALGORITHM=HS256

# --- Private media links ---
MEDIA_SIGNING_KEY=insecure-dev-media-key-change-me
MEDIA_URL_TTL_SECONDS=3600

# --- CORS (owner app origin) ---
ALLOWED_ORIGINS=http://localhost:5175

# --- Storage ---
UPLOADS_DIR=./uploads
# Same directory portfolio-builder publishes to (served by the wildcard host).
PUBLISHED_SITES_DIR=./published_sites
MAX_UPLOAD_BYTES=10485760
MAX_SOURCE_IMAGES=8
SOURCE_IMAGE_RETENTION_DAYS=30

# --- Public storefront URLs: <slug>.<BASE_DOMAIN> ---
BASE_DOMAIN=localhost
PUBLIC_SCHEME=http
PUBLIC_PORT=8081
MAX_STORES_PER_USER=1

# --- AI provider: anthropic | azure_openai | disabled ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
QR_AI_MODEL=claude-opus-5-5
QR_AI_EFFORT=medium
QR_AI_REFUSAL_FALLBACK=true
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AI_TIMEOUT_SECONDS=180
AI_MAX_ATTEMPTS=3
AI_WORKERS=2

# --- Plans / quota (seed values; edit later in /admin) ---
QUOTA_TIMEZONE=Asia/Kolkata
QR_FREE_MONTHLY_UPDATES=5
QR_PRO_MONTHLY_UPDATES=
QR_STORE_PRO_PRICE_RUPEES=0
QR_SPLIT_BILL_PRICE_RUPEES=0
QR_PRO_SPLIT_PRICE_RUPEES=0
SPLIT_BILL_FREE_MONTHLY=20
PAID_PLAN_DURATION_DAYS=365

# --- Split Bill (restaurants) ---
SPLIT_BILL_MAX_PARTICIPANTS=20
SPLIT_BILL_MAX_PER_STORE_PER_DAY=300
SPLIT_BILL_MAX_PER_PHONE_PER_DAY=6
# WhatsApp Business Cloud API. Leave blank to use click-to-chat links instead.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_SPLIT_BILL_TEMPLATE=
WHATSAPP_SPLIT_BILL_TEMPLATE_LANG=en
# 7 = template has the QR-link variable {{7}}; 6 = UPI ID only
WHATSAPP_SPLIT_BILL_TEMPLATE_VARS=6
WHATSAPP_SPLIT_BILL_IMAGE_HEADER=false
