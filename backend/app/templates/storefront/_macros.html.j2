{# Reusable storefront fragments shared by every template. #}

{% macro img(image, alt, sizes="(max-width: 600px) 50vw, 300px", cls="", eager=false) -%}
<img src="{{ image.src }}"{% if image.srcset %} srcset="{{ image.srcset }}" sizes="{{ sizes }}"{% endif %}
     width="{{ image.width }}" height="{{ image.height }}" alt="{{ alt }}" class="{{ cls }}"
     {% if eager %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
{%- endmacro %}

{# Placeholder art is clearly decorative: an icon, never a stock photo
   that could be mistaken for the actual product. #}
{% macro media(item, sizes="(max-width: 600px) 50vw, 300px") -%}
<div class="item-media{% if not item.image %} is-placeholder{% endif %}">
  {% if item.image %}{{ img(item.image, item.name, sizes) }}
  {% else %}<span class="ph-icon" aria-hidden="true">{{ placeholder_icon }}</span><span class="sr-only">No photo yet</span>{% endif %}
  {% if not item.available %}<span class="badge badge-out">Unavailable</span>{% endif %}
</div>
{%- endmacro %}

{% macro labels(item) -%}
{% if item.labels %}<ul class="labels">{% for l in item.labels %}<li class="label label-{{ l.key }}">{% if l.key in ("veg", "non_veg", "egg") %}<span class="diet diet-{{ l.key }}" aria-hidden="true"></span>{% endif %}{{ l.text }}</li>{% endfor %}</ul>{% endif %}
{%- endmacro %}

{% macro price(item) -%}
{% if item.price_label %}<span class="price">{{ item.price_label }}</span>
{% elif item.variants %}<span class="price price-muted">See options</span>
{% else %}<span class="price price-muted">Ask for price</span>{% endif %}
{%- endmacro %}

{% macro variants(item) -%}
{% if item.variants %}<ul class="variants">{% for v in item.variants %}<li><span>{{ v.name }}</span>{% if v.label %}<span>{{ v.label }}</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
{%- endmacro %}

{% macro actions(item) -%}
<div class="item-actions">
  <button type="button" class="btn btn-add" data-add="{{ item.id }}"{% if not item.available %} disabled aria-disabled="true"{% endif %}>
    {% if item.available %}Add to list{% else %}Unavailable{% endif %}
  </button>
  <a class="btn btn-wa btn-icon" data-enquire="{{ item.id }}" href="#" target="_blank" rel="noopener"
     aria-label="Enquire about {{ item.name }} on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg><span class="btn-icon-label">Enquire</span></a>
</div>
{%- endmacro %}

{% macro details_button(item) -%}
<button type="button" class="item-open" data-open="{{ item.id }}" aria-label="View details of {{ item.name }}"></button>
{%- endmacro %}

{# Hidden detail fragment cloned into the item dialog by store.js #}
{% macro detail(item) -%}
<template id="detail-{{ item.id }}">
  {% if item.image %}<div class="detail-media">{{ img(item.image, item.name, "(max-width: 600px) 100vw, 560px") }}</div>{% endif %}
  {{ price(item) }}
  {{ labels(item) }}
  {% if item.description %}<p class="detail-desc">{{ item.description }}</p>{% endif %}
  {{ variants(item) }}
  {% if not item.available %}<p class="warning">Currently unavailable.</p>{% endif %}
  {{ actions(item) }}
</template>
{%- endmacro %}

{% macro brand_header(cls="") -%}
<header class="brand-header {{ cls }}">
  {% if logo %}<div class="logo">{{ img(logo, store.name ~ " logo", "96px", "", true) }}</div>
  {% else %}<div class="logo logo-fallback" aria-hidden="true">{{ store.name[:1] | upper }}</div>{% endif %}
  <div class="brand-text">
    <h1>{{ store.name }}</h1>
    {% if store.tagline %}<p class="tagline">{{ store.tagline }}</p>{% endif %}
    {% if store.city %}<p class="where">{{ category.icon }} {{ category.label.split(",")[0].split("&")[0] | trim }} · {{ store.city }}</p>{% endif %}
  </div>
</header>
{%- endmacro %}

{% macro contact_strip() -%}
<div class="contact-strip">
  {% if store.whatsapp %}<a class="btn btn-wa" href="https://wa.me/{{ store.whatsapp }}" target="_blank" rel="noopener">WhatsApp us</a>{% endif %}
  {% if store.phone %}<a class="btn btn-ghost" href="tel:{{ store.phone }}">Call</a>{% endif %}
  {% if store.maps_url %}<a class="btn btn-ghost" href="{{ store.maps_url }}" target="_blank" rel="noopener">Directions</a>{% endif %}
  {% if store.zomato_url %}<a class="btn btn-zomato" href="{{ store.zomato_url }}" target="_blank" rel="noopener">Order on Zomato</a>{% endif %}
  {% if store.swiggy_url %}<a class="btn btn-swiggy" href="{{ store.swiggy_url }}" target="_blank" rel="noopener">Order on Swiggy</a>{% endif %}
  {% if split_bill %}<button type="button" class="btn btn-split" data-split-open aria-haspopup="dialog" aria-controls="split"><span aria-hidden="true">🧾</span> Split Bill <span class="new-badge">New</span></button>{% endif %}
</div>
{%- endmacro %}
